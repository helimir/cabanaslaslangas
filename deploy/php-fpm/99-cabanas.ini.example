; ============================================================================
; PHP-FPM — Cabañas Las Lengas
; ----------------------------------------------------------------------------
; Copiar a: /etc/php/8.3/fpm/conf.d/99-cabanas.ini  (ajustar versión de PHP)
; Luego:    sudo systemctl restart php8.3-fpm
;
; Necesario porque la galería de cabañas permite subir VARIAS imágenes en una
; misma petición (hasta 5 MB cada una).
; ============================================================================

upload_max_filesize = 10M
post_max_size = 60M
max_file_uploads = 30
max_execution_time = 120
max_input_time = 120
memory_limit = 256M

; Errores: en producción no mostrar en pantalla (el proyecto lo controla con
; APP_DEBUG en .env, pero conviene reforzarlo a nivel de PHP).
display_errors = Off
log_errors = On
error_log = /var/log/php/cabanaslaslengas-php-error.log

date.timezone = America/Santiago
