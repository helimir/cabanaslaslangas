# ============================================================
# Cabañas Las Lengas - ejemplo de configuración
# ============================================================
# Copia este archivo como ".env" y completa los valores reales.
# El archivo .env NO se sube a git (está en .gitignore).
#
#   Copiar en Windows:   Copy-Item .env.example .env
#   Copiar en Linux:     cp .env.example .env
# ============================================================

# ------------------------------------------------------------
# Aplicación
# ------------------------------------------------------------
APP_NAME="Cabañas Las Lengas"
# local | production
APP_ENV=production
# true muestra los errores de PHP en pantalla (solo desarrollo)
APP_DEBUG=false
# URL pública del sitio, CON barra final.
# En producción (APP_ENV=production) es la URL real.
# En desarrollo (APP_ENV=local) se autodetecta desde el navegador y este valor se ignora.
APP_URL=https://cabanaslaslengas.cl/
APP_TIMEZONE=America/Santiago

# ------------------------------------------------------------
# Base de datos (MySQL / MariaDB)
# ------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=laslengas
DB_USER=usuario_de_la_base
DB_PASS=clave_de_la_base

# ------------------------------------------------------------
# Correo — SendGrid (RECOMENDADO)
# Se envía por la API HTTPS (puerto 443): no usa SMTP ni el puerto 25,
# por lo que funciona en Hetzner/VPS sin servidor de correo local.
#
# 1) Crear cuenta en https://sendgrid.com
# 2) Verificar el remitente en Settings > Sender Authentication
#    (Single Sender Verification o Domain Authentication).
# 3) Crear API Key en Settings > API Keys con permiso "Mail Send".
# 4) Probar en el servidor:  php tools/test_mail.php correo@destino.cl
# ------------------------------------------------------------
MAIL_DRIVER=sendgrid
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MAIL_FROM_ADDRESS=reservaciones@cabanaslaslengas.cl
MAIL_FROM_NAME="Cabañas Las Lengas"
# Correo que recibe las notificaciones de nuevas reservas
MAIL_ADMIN_ADDRESS=reservaciones@cabanaslaslengas.cl

# ------------------------------------------------------------
# Alternativa: SMTP (SendGrid SMTP u otro proveedor)
# SendGrid SMTP: host smtp.sendgrid.net, puerto 587, usuario "apikey"
# y contraseña = API key. Para usarlo, cambiar MAIL_DRIVER=smtp y
# descomentar las líneas siguientes.
# ------------------------------------------------------------
# MAIL_DRIVER=smtp
# MAIL_HOST=smtp.sendgrid.net
# MAIL_PORT=587
# MAIL_USERNAME=apikey
# MAIL_PASSWORD=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# MAIL_ENCRYPTION=tls

# ------------------------------------------------------------
# Google reCAPTCHA (formulario de reservas)
# ------------------------------------------------------------
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
